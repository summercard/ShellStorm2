; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[android]

modules=""
gradle_build/use_gradle_build=true
gradle_build/gradle_version=""
gradle_build/android_source_template=""
gradle_build/compress_native_libraries=false
gradle_build/export_format=0
gradle_build/min_sdk=24
gradle_build/target_sdk=34
package/unique_name="org.shellstorm2.game"
package/name="ShellStorm2"
package/signed=true
package/app_category=2
version/code=1
version/name="0.1.0"
screen/immersive_mode=true
screen/allow_secure_volume_controls=false
screen/force_landscape=true
screen/force_portrait=false
screen/support_small=true
screen/support_normal=true
screen/support_large=true
screen/support_xlarge=true
permissions/access_network_state=true
permissions/internet=true
permissions/vibrate=true
permissions/wake_lock=true
permissions/keep_screen_on=true
permissions/manage_external_storage=false
permissions/read_external_storage=false
permissions/write_external_storage=false
permissions/camera=false
permissions/microphone=false
permissions/record_audio=false
permissions/access_fine_location=false
permissions/access_coarse_location=false
permissions/access_background_location=false
permissions/bluetooth=false
permissions/bluetooth_admin=false
permissions/modify_audio_settings=false
permissions/post_notifications=false

[application]

config/name="弹壳风暴2"
config/description="顶视角射击搜打撤肉鸽游戏"
config/version="0.1.0"
run/main_scene="res://scenes/TowerDescent3D.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

Global="*res://src/core/Global.gd"
GameManager="*res://src/core/GameManager.gd"
AudioManager="*res://src/core/AudioManager.gd"
BaseManager="*res://src/base/BaseManager.gd"
BlueprintRegistry="*res://src/base/BlueprintRegistry.gd"
FateCardGameBridge="*res://src/game/FateCardGameBridge.gd"
LevelSelect="*res://src/game/LevelSelectState.gd"
MobileInput="*res://src/ui/MobileInput.gd"
MonsterAIManager="*res://src/enemy3d/MonsterAIManager.gd"
EliteRosterService="*res://src/enemy3d/EliteRosterService.gd"
GameplaySpatialRegistry3D="*res://src/core/GameplaySpatialRegistry3D.gd"
GraphicsSettingsManager="*res://src/core/GraphicsSettingsManager.gd"
RuntimePerformanceManager="*res://src/core/RuntimePerformanceManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

