[gd_resource type="Resource" script_class="MapThemeProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/map/MapThemeProfile.gd" id="1_theme"]

[resource]
script = ExtResource("1_theme")
theme_id = "abyss_archive"
display_name = "深渊档案库"
fantasy = "封存失败实验与精英档案的禁区。路线偏向高压连续战斗，支线用于换取最后的构筑机会。"
difficulty_rank = 4
visual_floor = 4
layout_rules = {"pattern": "elite_gauntlet", "path_length": 9, "branch_chance": 0.68, "basement_chance": 0.45, "upper_chance": 0.45, "sequence_variation_chance": 0.05, "path_sequence": ["COMBAT", "ELITE", "EVENT", "TRAP"], "vertical_room_weights": {"ELITE": 4.0, "COMBAT": 3.0, "STORAGE": 2.0, "EVENT": 1.0}}
path_room_weights = {"COMBAT": 4.0, "ELITE": 4.0, "EVENT": 1.0, "TRAP": 2.0}
branch_room_weights = {"UPGRADE": 3.0, "STORAGE": 2.0, "EVENT": 2.0, "ELITE": 2.0, "TRAP": 2.0}
required_branch_types = Array[String](["UPGRADE", "STORAGE"])
enemy_rules = {"enemy_pool": ["shielded", "summoner", "ambusher", "ranged_caster", "exploder", "shielded"], "hp_multiplier": 1.15, "damage_multiplier": 1.12, "speed_multiplier": 1.05, "name_prefix": "档案失控体·", "boss_name": "禁区馆长"}
content_rules = {"container_bonus": 1, "event_pool": ["curse", "ambush", "gamble", "blessing"]}
npc_rules = Array[Dictionary]([{"id": "archive_keeper", "name": "残存档案员", "role": "精英悬赏记录", "text": "这里记录的东西会记住你，并在下一次变得更强。", "room_types": ["EVENT"], "chance": 0.9, "position": Vector2(0, 110), "color": Color(0.75, 0.25, 0.75, 1)}, {"id": "archive_engineer", "name": "封存工程师", "role": "终局构筑调整", "text": "最后一次改造机会，之后就只剩撤离或死亡。", "room_types": ["UPGRADE"], "chance": 1.0, "position": Vector2(-110, 80), "color": Color(0.45, 0.5, 0.9, 1)}])
