npc_rules = Array[Dictionary]([{"id": "foundry_mechanic", "name": "流亡机械师", "role": "生产线改造", "text": "机器不会停，但可以让它们替你工作。", "room_types": ["UPGRADE"], "chance": 1.0, "position": Vector2(100, 90), "color": Color(0.9, 0.48, 0.2, 1)}, {"id": "foundry_salvager", "name": "炉渣拾荒者", "role": "库存情报", "text": "地下库存更肥，也更容易被堵死。", "room_types": ["STORAGE"], "chance": 0.7, "position": Vector2(-100, 80), "color": Color(0.7, 0.55, 0.28, 1)}])
