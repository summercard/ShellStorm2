[gd_scene load_steps=5 format=3 uid="uid://room_combat"]

[ext_resource type="Script" path="res://src/map/RoomWaveSpawner.gd" id="1_spawner"]
[ext_resource type="Script" path="res://src/map/RoomVisualizer.gd" id="2_visualizer"]
[ext_resource type="Script" path="res://src/map/RoomDoorVisualizer.gd" id="3_door_viz"]

[node name="RoomCombat" type="Node2D"]
script = ExtResource("2_visualizer")

; 波次生成器（由 RoomGameMode 配置并驱动）
[node name="WaveSpawner" type="Node" parent="."]
script = ExtResource("1_spawner")

; TileMap 地面/墙体层
[node name="FloorLayer" type="TileMapLayer" parent="."]

[node name="SpawnMarker" type="Marker2D" parent="."]

; 战斗房氛围装饰
[node name="AmbientDecoration" type="Node2D" parent="."]

; 角落暗角（左上）
[node name="CornerShadow_TL" type="ColorRect" parent="AmbientDecoration"]
custom_minimum_size = Vector2(120, 120)
offset_left = -440.0
offset_top = -340.0
offset_right = -320.0
offset_bottom = -220.0
color = Color(0.08, 0.05, 0.05, 0.5)

; 角落暗角（右下）
[node name="CornerShadow_BR" type="ColorRect" parent="AmbientDecoration"]
custom_minimum_size = Vector2(120, 120)
offset_left = 320.0
offset_top = 220.0
offset_right = 440.0
offset_bottom = 340.0
color = Color(0.08, 0.05, 0.05, 0.5)

; 房间边界提示（边缘稍暗）
[node name="BoundaryOverlay" type="ColorRect" parent="."]
z_index = -5
custom_minimum_size = Vector2(800, 600)
offset_left = -400.0
offset_top = -300.0
offset_right = 400.0
offset_bottom = 300.0
color = Color(0.12, 0.12, 0.14, 0.2)

; 区域标记（中圈）
[node name="ZoneMarker_Center" type="ColorRect" parent="."]
z_index = -4
custom_minimum_size = Vector2(200, 200)
offset_left = -100.0
offset_top = -100.0
offset_right = 100.0
offset_bottom = 100.0
color = Color(0.18, 0.16, 0.16, 0.08)

; 门过渡视觉标记（由 RoomVisualizer 配置并显示方向）
[node name="DoorVisualizer" type="Node2D" parent="."]
script = ExtResource("3_door_viz")

; 战斗房默认尺寸（用于放置门和UI）
[node name="Area" type="Area2D" parent="."]
