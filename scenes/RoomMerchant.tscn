[gd_scene load_steps=5 format=3 uid="uid://room_merchant_001"]

[ext_resource type="Script" path="res://src/map/RoomTileSetBuilder.gd" id="1_tilebuilder"]
[ext_resource type="Script" path="res://src/game/MerchantInteraction.gd" id="2_merchant"]
[ext_resource type="Script" path="res://src/map/RoomTileMapInitializer.gd" id="3_tilemap_init"]
[ext_resource type="Script" path="res://src/map/RoomDoorVisualizer.gd" id="4_door_viz"]

; 商人房间 — 商人NPC站在房间中央，玩家可与其交易

[sub_resource type="CircleShape2D" id="CircleShape2D_area"]
radius = 60.0

[node name="RoomMerchant" type="Node2D"]

; 商人NPC碰撞检测区域
[node name="MerchantArea" type="Area2D" parent="."]
collision_layer = 0
collision_mask = 2
monitorable = true
script = ExtResource("2_merchant")

[node name="CollisionShape2D" type="CollisionShape2D" parent="MerchantArea"]
shape = SubResource("CircleShape2D_area")

; 商人NPC视觉节点（简单矩形代表商人）
[node name="Sprite" type="ColorRect" parent="."]
custom_minimum_size = Vector2(50, 60)
offset_left = -25.0
offset_top = -30.0
offset_right = 25.0
offset_bottom = 30.0
color = Color(0.9, 0.85, 0.3, 0.9)

; 交互提示标签
[node name="InteractLabel" type="Label" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -50.0
offset_top = -90.0
offset_right = 50.0
offset_bottom = -70.0
grow_horizontal = 2
text = "[E] 交易"
horizontal_alignment = 1
vertical_alignment = 1

; TileMap 地面/墙体层
[node name="FloorLayer" type="TileMapLayer" parent="."]

; 房间氛围装饰（角落暗角 + 边界提示）
[node name="AmbientDecoration" type="Node2D" parent="."]

[node name="CornerShadow_TL" type="ColorRect" parent="AmbientDecoration"]
custom_minimum_size = Vector2(120, 120)
offset_left = -440.0
offset_top = -340.0
offset_right = -320.0
offset_bottom = -220.0
color = Color(0.1, 0.08, 0.05, 0.45)

[node name="CornerShadow_BR" type="ColorRect" parent="AmbientDecoration"]
custom_minimum_size = Vector2(120, 120)
offset_left = 320.0
offset_top = 220.0
offset_right = 440.0
offset_bottom = 340.0
color = Color(0.1, 0.08, 0.05, 0.45)

; 房间边界提示（边缘稍暗）
[node name="BoundaryOverlay" type="ColorRect" parent="."]
z_index = -5
custom_minimum_size = Vector2(800, 600)
offset_left = -400.0
offset_top = -300.0
offset_right = 400.0
offset_bottom = 300.0
color = Color(0.15, 0.12, 0.08, 0.2)

; 区域标记（中圈）
[node name="ZoneMarker_Center" type="ColorRect" parent="."]
z_index = -4
custom_minimum_size = Vector2(200, 200)
offset_left = -100.0
offset_top = -100.0
offset_right = 100.0
offset_bottom = 100.0
color = Color(0.9, 0.75, 0.20, 0.06)

; 房间视觉化组件
[node name="Visualizer" type="Node2D" parent="."]
script = ExtResource("3_tilemap_init")
room_type = 4

; 门过渡视觉标记（由 RoomTileMapInitializer 配置并显示方向 — P2 补全）
[node name="DoorVisualizer" type="Node2D" parent="."]
script = ExtResource("4_door_viz")
