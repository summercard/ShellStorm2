; 改造房 — 工作台交互间
; 玩家在此房间可以通过工作台重新装配武器（枪身+子弹+配件）
; 工作台是 Area2D，可通过 interact 键触发装配界面

[sub_resource type="CircleShape2D" id="CircleShape2D_bench"]
radius = 60.0

[node name="RoomUpgrade" type="Node2D"]

; 工作台交互区域（挂 WorkbenchInteraction 脚本）
[node name="WorkbenchArea" type="Area2D" parent="."]
collision_layer = 0
collision_mask = 2
monitorable = true
script = ExtResource("2_workbench")

[node name="CollisionShape2D" type="CollisionShape2D" parent="WorkbenchArea"]
shape = SubResource("CircleShape2D_bench")

; 工作台视觉（底座+机械臂外形）
[node name="BenchBase" type="ColorRect" parent="."]
custom_minimum_size = Vector2(80, 80)
offset_left = -40.0
offset_top = -40.0
offset_right = 40.0
offset_bottom = 40.0
color = Color(0.4, 0.35, 0.3, 0.9)

[node name="BenchArm" type="ColorRect" parent="."]
