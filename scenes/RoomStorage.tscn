[gd_scene load_steps=8 format=3 uid="uid://room_storage_001"]

[ext_resource type="PackedScene" path="res://scenes/Container.tscn" id="1_container"]
[ext_resource type="Script" path="res://src/map/RoomWaveSpawner.gd" id="2_spawner"]
[ext_resource type="Script" path="res://src/map/RoomTileSetBuilder.gd" id="3_tilebuilder"]
[ext_resource type="Script" path="res://src/game/StorageRoomLogic.gd" id="4_storage"]
[ext_resource type="Script" path="res://src/game/ContainerInteraction.gd" id="5_container_script"]
[ext_resource type="Script" path="res://src/map/RoomTileMapInitializer.gd" id="6_tilemap_init"]
[ext_resource type="Script" path="res://src/map/RoomDoorVisualizer.gd" id="7_door_viz"]

[sub_resource type="CircleShape2D" id="CircleShape2D_area"]
radius = 45.0

; 藏储室场景 — 隐藏容器房间
; 房间角落有隐藏箱，需要探索或特定条件（钥匙/条件触发）才能开启
; 可能有守卫怪物守护高价值物品
; 颜色主题：棕色/焦糖色（与 STORAGE 房间调试色一致）

[node name="RoomStorage" type="Node2D"]
script = ExtResource("4_storage")

; 波次生成器（由 RoomGameMode 配置并驱动）
[node name="WaveSpawner" type="Node" parent="."]
script = ExtResource("2_spawner")

; 隐藏箱（藏在房间角落，需要探索发现）
[node name="HiddenChest" type="Node2D" parent="."]
position = Vector2(-320, -180)

[node name="Container" type="Area2D" parent="HiddenChest"]
collision_layer = 0
collision_mask = 2
monitorable = true
script = ExtResource("5_container_script")
container_type = "hidden_cache"
loot_table = "scavenge_floor_3"

[node name="CollisionShape2D" type="CollisionShape2D" parent="HiddenChest/Container"]
shape = SubResource("CircleShape2D_area")

; 隐藏箱的视觉标记（比普通箱子小且暗，需要靠近才能看到）
[node name="Sprite" type="ColorRect" parent="HiddenChest"]
custom_minimum_size = Vector2(30, 30)
offset_left = -15.0
offset_top = -15.0
offset_right = 15.0
offset_bottom = 15.0
color = Color(0.4, 0.25, 0.1, 0.7)

[node name="InteractLabel" type="Label" parent="HiddenChest"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -40.0
offset_top = -50.0
offset_right = 40.0
offset_bottom = -35.0
grow_horizontal = 2
text = "[E] 搜索"
horizontal_alignment = 1
vertical_alignment = 1

; 辅助箱（房间另一侧，提供基础掉落）
[node name="Crate" type="Node2D" parent="."]
position = Vector2(200, 120)

[node name="Container" type="Area2D" parent="Crate"]
collision_layer = 0
collision_mask = 2
monitorable = true
script = ExtResource("5_container_script")
container_type = "crate"
loot_table = "scavenge_floor_3"

[node name="InteractionArea" type="CollisionShape2D" parent="Crate/Container"]
shape = SubResource("CircleShape2D_area")

[node name="Sprite" type="ColorRect" parent="Crate/Container"]
custom_minimum_size = Vector2(40, 40)
offset_left = -20.0
offset_top = -20.0
offset_right = 20.0
offset_bottom = 20.0
color = Color(0.7, 0.6, 0.2, 0.85)

[node name="InteractLabel" type="Label" parent="Crate/Container"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -40.0
offset_top = -65.0
offset_right = 40.0
offset_bottom = -45.0
grow_horizontal = 2
text = "[E] 开启"
horizontal_alignment = 1
vertical_alignment = 1

; 房间氛围装饰（暗角/边界提示）
[node name="AmbientDecoration" type="Node2D" parent="."]

[node name="CornerShadow1" type="ColorRect" parent="AmbientDecoration"]
custom_minimum_size = Vector2(100, 100)
offset_left = -450.0
offset_top = -350.0
offset_right = -350.0
offset_bottom = -250.0
color = Color(0.1, 0.05, 0.0, 0.4)

[node name="CornerShadow2" type="ColorRect" parent="AmbientDecoration"]
custom_minimum_size = Vector2(100, 100)
offset_left = 350.0
offset_top = 250.0
offset_right = 450.0
offset_bottom = 350.0
color = Color(0.1, 0.05, 0.0, 0.4)

; TileMap 地面/墙体层
[node name="FloorLayer" type="TileMapLayer" parent="."]

; 房间视觉化组件（运行时构建 TileSet + 氛围装饰）
[node name="Visualizer" type="Node2D" parent="."]
script = ExtResource("6_tilemap_init")
room_type = 9

; 门过渡视觉标记（由 RoomTileMapInitializer 配置并显示方向 — P2 补全）
[node name="DoorVisualizer" type="Node2D" parent="."]
script = ExtResource("7_door_viz")
