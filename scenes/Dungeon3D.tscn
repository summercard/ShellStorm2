[sub_resource type="Shader" id="ShaderLowHealth"]
code = "shader_type canvas_item;\nrender_mode unshaded;\nuniform float intensity : hint_range(0.0, 1.0) = 0.0;\nvoid fragment() {\n    float d = distance(UV, vec2(0.5));\n    float edge = smoothstep(0.30, 0.69, d);\n    COLOR = vec4(0.72, 0.025, 0.018, edge * intensity * 0.62);\n}\n"

[sub_resource type="ShaderMaterial" id="MaterialLowHealth"]
