[gd_scene format=3 uid="uid://fate_card_ui_controller"]

[ext_resource type="Script" path="res://src/ui/FateCardUIController.gd" id="1_fate_card_ui"]

; 命运卡片选择 UI 控制器场景
; 最小化 Control 节点，内嵌 FateCardPanel 结构用于 Demo 独立模式
; 正式关卡使用 GameUIManager/FateCardPanel（场景 GameUIManager.tscn）
; Demo 模式独立运行时使用本场景内嵌面板

[node name="FateCardUIController" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_fate_card_ui")

[node name="FateCardPanel" type="Panel" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -180.0
offset_right = 200.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="FateCardPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="InstructionLabel" type="Label" parent="FateCardPanel/VBox"]
layout_mode = 2
text = "选择一张命运卡片（Tab关闭）"
horizontal_alignment = 1

[node name="CardOptions" type="HBoxContainer" parent="FateCardPanel/VBox"]
layout_mode = 2
alignment = 1