[sub_resource type="RectangleShape2D" id="RectangleShape2D_trigger"]
size = Vector2(800, 700)

; 陷阱房场景 — 环境危险 + 怪物埋伏
; 进入房间时可能有陷阱触发（如毒雾、落石）
; 角落埋伏着怪物，玩家开门时突袭
; 颜色主题：暗红/危险色（与 TRAP 房间调试色一致）

[node name="RoomTrap" type="Node2D"]
script = ExtResource("3_trap")

; 波次生成器（由 RoomGameMode 配置并驱动）
[node name="WaveSpawner" type="Node" parent="."]
script = ExtResource("1_spawner")

[node name="RoomTrigger" type="Area2D" parent="."]
collision_layer = 0
collision_mask = 2
monitorable = true

[node name="CollisionShape2D" type="CollisionShape2D" parent="RoomTrigger"]
shape = SubResource("RectangleShape2D_trigger")

; 环境危险提示区
[node name="DangerZone1" type="Area2D" parent="."]
position = Vector2(-200, -100)

[node name="DangerSprite1" type="ColorRect" parent="DangerZone1"]
custom_minimum_size = Vector2(80, 80)
offset_left = -40.0
offset_top = -40.0
offset_right = 40.0
offset_bottom = 40.0
color = Color(0.5, 0.1, 0.1, 0.3)

[node name="Label" type="Label" parent="DangerZone1"]
offset_left = -30.0
offset_top = -60.0
offset_right = 30.0
offset_bottom = -45.0
text = "危险"
horizontal_alignment = 1

[node name="DangerZone2" type="Area2D" parent="."]
position = Vector2(200, 100)

[node name="DangerSprite2" type="ColorRect" parent="DangerZone2"]
custom_minimum_size = Vector2(80, 80)
offset_left = -40.0
