; 陷阱触发提示（玩家进入房间时显示警告）
[node name="TrapWarningLabel" type="Label" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -80.0
offset_top = -200.0
offset_right = 80.0
offset_bottom = -180.0
grow_horizontal = 2
text = "⚠ 陷阱房 ⚠"
horizontal_alignment = 1
visible = false

; 埋伏怪物标记（伏击点）
[node name="AmbushMarker1" type="Marker2D" parent="."]
position = Vector2(-350, -200)

[node name="AmbushMarker2" type="Marker2D" parent="."]
position = Vector2(350, 200)

; 房间氛围（暗红色调）
[node name="AmbientBackground" type="ColorRect" parent="."]
z_index = -10
