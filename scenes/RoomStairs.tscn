[gd_scene load_steps=5 format=3 uid="uid://room_stairs_001"]

[ext_resource type="Script" path="res://src/game/RoomStairs.gd" id="1_room_stairs"]
[ext_resource type="Script" path="res://src/map/RoomTileMapInitializer.gd" id="2_tileinit"]
[ext_resource type="Script" path="res://src/game/StairsInteraction.gd" id="3_stairs"]
[ext_resource type="Script" path="res://src/map/RoomDoorVisualizer.gd" id="4_door_viz"]

; 楼梯房场景 — 垂直楼层连接点
; 玩家按E键切换到地下室/二楼
; room_type 由 Visualizer.room_type 决定方向（12=STAIRS_DOWN, 13=STAIRS_UP, 14=ELEVATOR）
; 颜色主题：暖棕橙调（与 STORAGE 系统略有区分，accent 偏橙表示通道）

[node name="RoomStairs" type="Node2D"]
script = ExtResource("1_room_stairs")

; 楼梯交互区域
[node name="StairsArea" type="Area2D" parent="."]

[node name="StairsInteraction" type="Area2D" parent="StairsArea"]
script = ExtResource("3_stairs")
direction = "down"
target_vertical = -1
interaction_radius = 80.0

[node name="CollisionShape2D" type="CollisionShape2D" parent="StairsArea/StairsInteraction"]
position = Vector2(0, 0)

[node name="InteractLabel" type="Label" parent="StairsArea/StairsInteraction"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -40.0
offset_top = -65.0
offset_right = 40.0
offset_bottom = -45.0
grow_horizontal = 2
text = "[E] 楼梯"
horizontal_alignment = 1
vertical_alignment = 1

; TileMap 地面/墙体层
[node name="FloorLayer" type="TileMapLayer" parent="."]

; 房间视觉化组件（运行时构建 TileSet + 氛围装饰）
; room_type 由编辑器设置：12=STAIRS_DOWN, 13=STAIRS_UP, 14=ELEVATOR
[node name="Visualizer" type="Node2D" parent="."]
script = ExtResource("2_tileinit")
room_type = 12

; 门过渡视觉标记
[node name="DoorVisualizer" type="Node2D" parent="."]
script = ExtResource("4_door_viz")