; BOSS 房间 — 玩家挑战 Boss 的专用场景
; 风格：深红/纯黑主题，中央 Boss 站位光圈，四角暗角
; 进入后玩家需要击败 Boss 才能开启撤离流程

[node name="RoomBoss" type="Node2D"]
script = ExtResource("1_boss_logic")

; TileMap 地面/墙体层（BOSS 主题：深红/纯黑）
[node name="FloorLayer" type="TileMapLayer" parent="."]

; 波次生成器（由 RoomGameMode 配置并驱动 — Boss 房也是战斗房）
[node name="WaveSpawner" type="Node" parent="."]
script = ExtResource("2_spawner")

; 房间视觉化组件（运行时构建 TileSet + 氛围装饰）
[node name="Visualizer" type="Node2D" parent="."]
