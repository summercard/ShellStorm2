[sub_resource type="RectangleShape2D" id="RectangleShape2D_room"]
size = Vector2(800, 600)

; ELITE 精英战斗房 — 独立场景
; 风格：深蓝/金属地板 + 禁区感氛围，四角暗角更重，中央危险区标记
; 与 RoomCombat.tscn 的灰色工业风区分开

[node name="RoomElite" type="Node2D"]
script = ExtResource("2_visualizer")

; 波次生成器（由 RoomGameMode 配置并驱动）
[node name="WaveSpawner" type="Node" parent="."]
