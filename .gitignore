# Godot 4.x specific
.godot/
*.import
!assets/art/enemies/normal_enemy_3d/melee_chaser/components/*.glb.import
# Scene/facility GLB import contracts carry the shared-palette post-import hook.
# 规则族：**每个组件库分区各一条**（<zone>/components/**/*.glb.import）。新增分区
# （如 tower_zones/expedition）时必须同步加一条，否则该区 GLB 的 .import 会被上面的
# *.import 吞掉、不入库 —— 干净克隆重新导入就丢掉共享色盘钩子，模型颜色会静默走样。
!assets/art/environments/base_facility_3d/components/**/*.glb.import
!assets/art/environments/tower_descent_3d/components/**/*.glb.import
!assets/art/props/base_world_3d/components/**/*.glb.import
!assets/art/items_weapons/props/**/components/*.glb.import
!assets/art/environments/tower_zones/battle/components/**/*.glb.import
!assets/art/environments/tower_zones/expedition/components/**/*.glb.import
!assets/art/environments/open_world/components/**/*.glb.import
!assets/art/environments/tower_zones/rooftop/components/*.glb.import
!assets/art/shared/palette/设施低亮多巴胺色盘_10x10_512.png.import
*.translation
*.inspect.ndjson
*.bak
*.backup

# Editor
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# Build outputs
bin/
build/
# 依赖目录。node_modules 常是指向全局缓存的**符号链接**，而本机 core.symlinks=false，
# git 会把它当真实目录，一次 add 就把数万个包文件吞进提交（实测 _scratch/*_ledger）。
node_modules/
outputs/*
!outputs/.gdignore
.codex-tmp/
.dev-cycle/
*.blend1
*.pck
*.exe
*.dmg
*.app
*.apk
*.aab

# Android export template (auto-generated by Godot on first Android export)
android/

# OS
.DS_Store
Thumbs.db
*.log

# Project specific (sensitive)
export_presets.cfg
*.keystore

# Blender/Godot import temp files
*.import~RF*.TMP
# Godot 导入被中断时留下的临时文件（形如 xxx_512.png.import88383379.tmp）
*.import[0-9]*.tmp

# Python 编译缓存（不该入库；已有 39 个 .pyc 被误提交，2026-09-17 已从索引移除）
__pycache__/
*.pyc

# 一次性备份（如台账补丁前的 .xlsx.bak_b1_deversion）
*.bak_*

# 每批去版本化迁移的临时基线快照 / 中途工作副本（台账补丁前后对照等）
_scratch/b2_baseline/
_scratch/b2_work/

# 验证套件的隔离工作区（run_verification_suite.sh 的 mktemp 基址，单轮约 5 GB；
# 放在项目盘而非系统盘，避免被强杀留下的残留写满 C:）
_scratch/.verify_ws/

# 补丁前的基线快照（台账/动画改前对照，用完即弃；与 b2_baseline 同类）
_scratch/*_before_*/
_scratch/*_before_*.blend
_scratch/*_backup/
# 注意：上面的 `*_before_*` 要求 _before_ 前后都非空 —— git 的段内 `*` **不匹配空串**
# （实测 git 2.55：`x_before_y.blend` 命中，`boss029_before.blend` 不命中）。所以
# 「下划线在前、点号在后」的命名要单独兜住，否则 144 MB 级 .blend 会直接撞 GitHub 100 MB 上限。
_scratch/*_before.blend
# 账本/资产补丁前的对照副本（以 _before 结尾的目录，或带 _sync_<日期> 的中间副本）
_scratch/*_before/
_scratch/*_sync_*/
# 「稳定版封存」与状态快照：整树镜像 assets 的 manifest/tscn，纯对照用，用完即弃。
# 命名把日期时间戳接在 _backup 后面，不满足「恰好以 _backup 结尾」，故单列。
_scratch/*_stable_backup_*/
_scratch/*_bounds_manifest_backup_*/
_scratch/**/status_before/
_scratch/**/status_after/
# 回滚/恢复前的整树备份（含 GLB 二进制副本）与其中任意层级的 *_before 目录
_scratch/*_restore_full_*/
_scratch/**/*_before/
# 探针另起的独立 Godot 校验工程（自带 .codex/skills 拷贝与 outputs 工作区，单次 3.5 万文件）。
# 临时脚手架，不是项目资产。
_scratch/*_qa_project/

# QA/验证工程里再落一层 outputs/（探针 mktemp 出来的校验工作区，单轮 6.5 万个文件，
# 且路径长度逼近 Windows 上限、git 直接读不了）。仓库根的 outputs/ 已有规则，这条兜住 _scratch 深层。
_scratch/**/outputs/

# 探针另起的 userdata 副本（base_save.json + shader_cache，机器本地，不是资产）。
# 既有规则只认 "appdata" 命名，这条兜住 "userdata" 写法。
_scratch/**/*userdata*/

# 动画/退役对照用的「整项目快照」。baseline_project.py / retirement_baseline.py 里的
# assets / scenes / data / tests 是 **junction 挂到真实目录**，不是拷贝 —— 入库会让 git
# 顺着 junction 把真实资产按影子路径再存一份重复 blob（含 8 MB 级 .blend），既是垃圾又浪费体积。
# 真副本由快照目录里的 project.godot + src/ 自己提供。
_scratch/**/*baseline*/

# 隔离运行工作区：探针为跑验收另起的 APPDATA / userdata 副本与渲染日志
# （Godot/app_userdata/<项目>/ 下的 logs、shader_cache、pipelines.*.cache、base_save.json）。
# 与 isolated_userdata/ 同类，机器本地产物，不是资产。
_scratch/**/isolated_*/
_scratch/**/app_userdata/

# Blender 自动保存的备份副本（与 .blend 同名只多一个 1，体积同款几十 MB，无版本价值）
*.blend1

# 开放世界的 Blender 源：单个 .blend 已达 0.9~1.1 GB，超 GitHub 100 MB 硬限，
# 无法入库（2026-10-02 业主裁定「源不入库」）。几何源留在本地盘，
# 仓库只留 catalog.json / qa 验收 / 预览图 / 构建脚本 / 账本，靠账本与脚本追溯。
# 注意：v001–v005 的 .blend 此前已入库（历史不动），本规则只挡新增。
assets/art/environments/open_world/source/**/*.blend

# Boss002 显示器 Boss 的 animation 母版：v028 起单文件已达 137~175 MB（v031 = 166.57 MB），
# 超 GitHub 100 MB 硬限，一次 push 会让整批提交被拒。与 open_world/source 同理 —— 源不入库：
# 几何 model 母版（6.6 MB）仍入库，运行时消费导出的 GLB/prefab，靠 asset_manifest、
# 生产账本与 scripts/blender/export_monitor_boss.py 追溯。注意 source/ 下的 .gdignore 只管
# Godot 导入器，**对 git 无效** —— 这就是这 4 个文件此前一直出现在 git status 里的原因。
# v001~v027 历史已入库（历史不动），本规则只挡新增。裁决（Git LFS / 异地归档）待业主定。
assets/art/enemies/bosses/enm_boss_monitor002/source/*_animation_v*.blend

# WorkBuddy 会话的临时探查脚本与运行日志（scratch，不入库；记忆与工具仍正常入库）
.workbuddy/tmp/

# Godot 运行期 appdata 副本（--headless 探针用独立 appdata 时落在项目内，非资产）
_godot_appdata*/
_scratch/probe_appdata/
_scratch/*_appdata/
# 同上，但探针把 appdata 落在了 _scratch/<子目录>/ 里（如 _scratch/fat_zombie03/isolated_appdata/）。
# 这类目录里是 editor_settings 之类的机器本地配置，含绝对路径，不是资产。
_scratch/**/*_appdata/
# 同上，但目录名把 appdata 夹在中间（如 _scratch/cloud_static_appdata_20261003/）。
# 里面是 Godot 的 shader_cache / pipelines.*.cache（单文件十余 MB），且含本机 GPU 型号串，不是资产。
_scratch/**/*appdata*/
isolated_userdata/

# 重新导出前的旧组件副本（内容与 HEAD 里那份逐字节相同，纯对照用，重导出完即弃）
_scratch/*_old_import/

# 产线过程日志与迭代截图目录。注意它**不在 _scratch/ 下**（是同级目录 `_scratch_logs/`），
# 因此上面那一大族 `_scratch/*` 规则一条都命中不了 —— 实测 46 文件 / 1.4 MB 全是
# 过程产物：hud_probe_r4/r5、hud_reg_r4/r5 这类反复迭代的验收日志，加一批
# loading_iris_shot_*.png 分帧截图（附 22 个 Godot 生成的 .png.import）。
# 需要留档的验收截图按项目既有约定放 outputs/verification/，不进这个目录。
_scratch_logs/

# 云海烘焙的中间体：由 source/v00X/build_*.py 按固定种子确定性生成（rng seed 写在脚本里），
# 运行时真正吃的是烘焙产物 cloud_keepout.res / cloud_noise.res。布局变化本来就要重烘焙。
assets/art/vfx/environment_3d/cloud_sea/source/**/*.raw

# 验证套件的隔离工作区「带业务后缀」变体（探针实际生成 .verify_ws_radio_v005 之类）。
# 上面 `_scratch/.verify_ws/` 是精确名，只命中不带后缀的，故补通配。
# 实测单轮 5.5 万文件 / 10.7 GB，且含符号链接自引用（git 报 Too many levels of symbolic links）。
_scratch/.verify_ws_*/

# 「收尾工程」副本：把整棵工程树复制出来做某版收口验证（如 radio_v005_finish_project），
# source/ 走 symlink 指回真实目录、_scratch 再落一层。单轮 3.4 万文件 / 6.8 GB。
# 与 *_qa_project 同类，是临时脚手架不是资产。
_scratch/*_finish_project/

# Blender 会话快照：改前把当前会话整档另存（session_before / session_before_open），
# 单文件 166 MB，直接撞 GitHub 100 MB 硬限。它位于 _scratch/<工作区>/ 的下一层，
# 既有 `_scratch/*_before.blend` 只覆盖 _scratch 直属层，故用 **/ 兜住深层。
_scratch/**/session_before*.blend

# 探针把 Godot 编辑器本地数据（editor_doc_cache-*.res）落在 *_localdata/ 目录。
# 既有规则只认 appdata / userdata 命名，这条补 localdata。
_scratch/**/*localdata*/

# bunny 玩家 animation 母版：v028 起单文件持续增长且已全部超 GitHub 100 MB 硬限
# （v028=117 / v029=136 / v030=183 / v031=214 / v032=248 / v033=264 MB），
# 一次 push 会让整批提交被拒。v027=94 MB 未超限，仍入库。
# 与 Boss002 animation / open_world 源同理 —— 源不入库：运行时消费的是导出的 GLB 与
# 剪辑清单（*_directional_v0XX.json / *_weapon_idles_v0XX.json），靠角色账本、
# character_transfer_ledger.json 与 scripts/blender/author_bunny_*.py 追溯。
#
# 这里**用模式而非逐条**：逐条排除已连续两轮漏网（v028 漏一次、v033 再漏一次），
# 每出新版都要回来补一行，漏一次就是整次 push 被拒。模式规则一次覆盖到 v099。
# v025/v026/v027 不受影响，仍入库。
assets/art/characters/player/chr_player_capsule01_3d/variants/bunny01/source/animation/chr_bunny01_animation_v02[89].blend
assets/art/characters/player/chr_player_capsule01_3d/variants/bunny01/source/animation/chr_bunny01_animation_v0[3-9]*.blend

# 98F facilities reproducible palette import contracts
!assets/art/environments/master_office_3d/components/**/*.glb.import
!assets/art/shared/palette/设施低亮多巴胺色盘_10x10_512.png.import
