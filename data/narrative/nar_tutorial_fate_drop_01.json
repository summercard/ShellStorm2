      { "speaker_id": "npc_base99_green", "speaker": "绿苔", "portrait_mode": "hologram", "expression": "neutral", "text": "那是命运凭据。靠近按E，先看看，不会自动花钱。", "auto_advance_sec": 3.4, "focus_target": "fate_pickup" },
      { "speaker_id": "player", "speaker": "主角", "expression": "question", "text": "给枪装一条新命运？", "auto_advance_sec": 2.2 },
