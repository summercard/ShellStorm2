      { "speaker_id": "npc_base99_green", "speaker": "绿苔", "portrait_mode": "hologram", "expression": "alert", "text": "喂，脚边那张亮的——先别当废纸踢了。", "auto_advance_sec": 3.0, "focus_target": "fate_pickup" },
