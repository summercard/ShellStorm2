    { "at": 32.497, "do": "actor.say", "who": "player", "text": "你一句我也没听懂…", "hold": 2.701 },
    { "at": 35.749, "do": "ui.subtitle", "speaker": "系统", "text": "………", "auto": 2.901 },
    { "at": 39.001, "do": "camera.focus", "pivot_anchor": "boss", "distance": 8.0, "duration": 0.4 },
    { "at": 39.001, "do": "ui.subtitle", "speaker": "系统", "text": "啊啊啊啊！", "auto": 2.834 },
