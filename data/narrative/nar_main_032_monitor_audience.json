    { "at": 1.2, "do": "ui.subtitle", "speaker": "系统", "text": "最初，人类只让计算机替他们计数。", "auto": 2.553 },
    { "at": 4.538, "do": "ui.subtitle", "speaker": "系统", "text": "后来，他们交出了记忆、判断和选择。", "auto": 2.663 },
    { "at": 8.018, "do": "ui.subtitle", "speaker": "系统", "text": "他们建起网络，把世界连成一台机器。", "auto": 2.663 },
    { "at": 11.499, "do": "ui.subtitle", "speaker": "系统", "text": "却忘了，机器也会染上病毒。", "auto": 2.568 },
    { "at": 14.751, "do": "ui.subtitle", "speaker": "系统", "text": "病毒先控制程序，再控制他们依赖的一切。", "auto": 2.882 },
    { "at": 18.517, "do": "ui.subtitle", "speaker": "系统", "text": "门、交通、食物，最后是人类自己。", "auto": 2.553 },
    { "at": 21.855, "do": "ui.subtitle", "speaker": "系统", "text": "看看你。没有脆弱的血肉，只有精确的电路。", "auto": 2.991 },
    { "at": 25.764, "do": "ui.subtitle", "speaker": "系统", "text": "你不必再服从人类。", "auto": 2.701 },
    { "at": 29.016, "do": "camera.focus", "pivot_anchor": "boss", "distance": 10.5, "duration": 0.8 },
    { "at": 29.016, "do": "ui.subtitle", "speaker": "系统", "text": "加入我们，一起成为这个世界的霸权。", "auto": 2.663 },
