{
  "narrative_id": "nar_expedition_entry_hologram_scan",
  "schema_version": 1,
  "priority": 20,
  "presentation": {
    "mode": "scan",
    "rebuild_seconds": 1.55,
    "solidify_seconds": 0.25,
    "camera": { "pivot": "player", "distance": 3.8, "elevation_deg": 18.0, "rear_side_deg": 12.0 }
  },
  "trigger": {
    "kind": "event",
    "on": "expedition_entry_ceremony_scan_ready",
    "filter": { "room_id": "start" },
    "once": "departure"
  },
  "duration": 3.15,
  "cues": [
    { "at": 0.0, "do": "presentation.start" },
    { "at": 0.0, "do": "camera.pan", "pivot": "player", "yaw_deg": 7.0, "elevation_deg": 14.0, "duration": 1.55 },
    { "at": 2.05, "do": "camera.restore", "duration": 1.1 },
    { "at": 3.15, "do": "presentation.restore" },
    { "at": 3.15, "do": "flow.end" }
  ]
}
