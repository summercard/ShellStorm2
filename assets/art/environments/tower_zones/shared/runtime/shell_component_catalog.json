  "scope": "shell",
  "single_source": "assets/art/environments/tower_zones/shared/source/common_components/v001/component_catalog.json",
  "exclusive_single_source": "assets/art/environments/tower_zones/expedition/source/common_components/v001/component_catalog.json",
  "consumers": [
    "src/world3d/DungeonRoom3D.gd::_authored_component_prefab()",
    "src/map/FloorPlanGenerator.gd::_load_boss_layout_instances()"
  ],
  "resolution_contract": {
    "primary_key": "components[].component_id（通用件名 ENV-SHARED-GENERIC-* / 专属件名 ENV-EXPEDITION-BOSSROOM-*）",
    "aliases": "等价 ID（同一件组件的具体批次号 ENV-BATTLE-COMMON-* / ENV-TOWER-*）。摆位两侧任写其一都必须解析到同一 prefab。",
    "kind": "generic = 跨房间/跨关卡复用的通用件；exclusive = 只属某一房间种类的专属件（kind 缺省视为 generic）。",
    "unknown_id": "返回 null 并 push_error，绝不静默换成别的组件。",
    "prefab_path": "运行时路径不带版本号；版本事实在 prefab 的 metadata/asset_version 与资产台账。",
    "prefab_asset_id": "prefab 根节点 metadata/asset_id 的期望值，由 qa/probe_shell_component_catalog.gd 逐件比对。",
    "alias_policy": "专属件不设 alias（只属一个房间种类、只有一条来源链）；alias 只用于通用件的批次号兼容。"
  },
