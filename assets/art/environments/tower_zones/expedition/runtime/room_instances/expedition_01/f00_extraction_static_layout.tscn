metadata/bounds_size_m = Vector3(5, 11.9, 5)
metadata/visual_bounds_size_m = Vector3(5.15, 11.9, 5.15)
metadata/bounds_note = "结构包络 5×11.9×5 = 转角起算的 L 标称占地（两臂各 5m），玩法阻挡 12m 高由本 Prefab 的两个 StaticBody3D 承担；可视包络 5.15×11.9×5.15 = 实测两臂装饰面都朝房内（长臂 −Z 0.3175 / 短臂 +X 0.3175，落在包络内部），包络外壳面分别是两条臂的结构背（长臂 +Z 0.15、短臂 −X 0.15），故只比结构盒各多 0.15。两个包络刻意分离：替换美术只改本条与可视声明，不得改碰撞。"
