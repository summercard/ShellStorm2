[node name="Imported_CornerL5M_GenericShell_CORNER_ROOM_10_NW" type="Node3D" parent="." unique_id=1714878700 instance=ExtResource("35_vvf0i")]
transform = Transform3D(-4.371139e-08, 0, -1, 0, 1, 0, 1, 0, -4.371139e-08, -20, 0, -15)
metadata/asset_id = "ENV-TOWER-CORNER-L-5M"
metadata/asset_version = "v001"
metadata/source_glb = "res://assets/art/environments/tower_descent_3d/components/env_tower_corner_l_5m_top3d.glb"
metadata/grid_unit_m = 5.0
metadata/logical_height_m = 12.0
metadata/visual_height_m = 11.9
metadata/visual_top_clearance_m = 0.1
metadata/origin_contract = "bottom_corner"
metadata/origin_note = "原点 = 转角（两臂交点），底面 Y=0。长臂沿 +X 覆盖 0..5m，短臂沿 -Z 覆盖 -5..0m；**房间内侧 = 两臂之间的凹象限（局部 +X/−Z）**，两条臂的装饰面都朝该侧（长臂 −Z、短臂 +X）。装配脚本按此摆位，勿把几何重新居中。"
metadata/forward_axis = "+Z"
metadata/forward_axis_note = "A 套家族标签：门禁要求六件一律 +Z（跨套混用会整体反 180°）。本件是 L 形、有两条臂，实际装饰面方向是长臂 −Z / 短臂 +X，没有单一的 +Z 朝向；见 origin_note。"
metadata/bounds_size_m = Vector3(5, 11.9, 5)
metadata/visual_bounds_size_m = Vector3(5.15, 11.9, 5.15)
metadata/bounds_note = "结构包络 5×11.9×5 = 转角起算的 L 标称占地（两臂各 5m），玩法阻挡 12m 高由本 Prefab 的两个 StaticBody3D 承担；可视包络 5.15×11.9×5.15 = 实测两臂装饰面都朝房内（长臂 −Z 0.3175 / 短臂 +X 0.3175，落在包络内部），包络外壳面分别是两条臂的结构背（长臂 +Z 0.15、短臂 −X 0.15），故只比结构盒各多 0.15。两个包络刻意分离：替换美术只改本条与可视声明，不得改碰撞。"
metadata/visual_node_name = "ENV_TOWER_CORNER_L_5M"
metadata/visual_bounds_policy = "envelope_carrier_node_union_of_visible_meshes"
metadata/visual_only = false
metadata/collision_owner = "self"
metadata/collision_note = "两条墙臂各一个 StaticBody3D（WallCollisionLong / WallCollisionShort），12m 高 0.30m 厚，随 Prefab 根移动。节点名是 DungeonRoom3D 的镜头下压契约，改名即回归。"
metadata/shadow_policy = "cast_and_receive"
metadata/preserve_authored_palette = true
metadata/runtime_instantiation = "per_instance_prefab"
metadata/instantiation_note = "每房间 4 个角各实例化一次（NW/NE/SW/SE 用 rotation_y 区分朝向），节点树保留。"
metadata/tower_wall_corner = "NW"
metadata/segment_index = 0
metadata/material_variant = "A"

