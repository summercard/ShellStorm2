[gd_scene load_steps=5 format=3]

; L 型房间拐角 v1 - 5m × 5m 双向覆盖9m逻辑高度；视觉高8.9m，顶部预留0.1m
; 默认朝向：+X 方向走 +Z 方向（L 角指向 -X / -Z 外侧为房间内）
; 用法：实例化时 rotation 决定 L 朝向（4 种）
; 节点命名：Wall_Long / Wall_Short（视觉上 L 形两臂）
; 碰撞：两条墙臂拆成独立 StaticBody3D，摄像机可只标记真正属于南墙的一臂

[sub_resource type="BoxMesh" id="BoxMesh_corner_L_long"]
size = Vector3(5, 8.9, 0.3)

[sub_resource type="BoxMesh" id="BoxMesh_corner_L_short"]
size = Vector3(0.3, 8.9, 5)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_corner"]
albedo_color = Color(0.28, 0.30, 0.32, 1)
metallic = 0.05
metallic_specular = 0.5
roughness = 0.75

[sub_resource type="BoxShape3D" id="BoxShape3D_corner_L_long"]
size = Vector3(5, 9, 0.3)

[sub_resource type="BoxShape3D" id="BoxShape3D_corner_L_short"]
size = Vector3(0.3, 9, 5)

[node name="PrpCornerL5m" type="Node3D"]

; 长臂沿 +X 方向：覆盖 0~5m 的 X,中心 x=+2.5
; 长臂处于房间一侧边缘（如东侧墙）
[node name="Wall_Long" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, 4.45, 0)
mesh = SubResource("BoxMesh_corner_L_long")
material_override = SubResource("StandardMaterial3D_corner")

; 短臂沿 -Z 方向：覆盖 0~5m 的 -Z,中心 z=-2.5
; 短臂处于房间一侧边缘（如北侧墙）
[node name="Wall_Short" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4.45, -2.5)
mesh = SubResource("BoxMesh_corner_L_short")
material_override = SubResource("StandardMaterial3D_corner")

[node name="WallCollisionLong" type="StaticBody3D" parent="."]
collision_layer = 1
collision_mask = 0

[node name="CollisionLong" type="CollisionShape3D" parent="WallCollisionLong"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, 4.5, 0)
shape = SubResource("BoxShape3D_corner_L_long")

[node name="WallCollisionShort" type="StaticBody3D" parent="."]
collision_layer = 1
collision_mask = 0

[node name="CollisionShort" type="CollisionShape3D" parent="WallCollisionShort"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4.5, -2.5)
shape = SubResource("BoxShape3D_corner_L_short")
